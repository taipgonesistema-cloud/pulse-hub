{
  "name": "projeto-main-dashboard",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev:infra": "docker compose up -d postgres redis",
    "dev:infra:down": "docker compose stop postgres redis",
    "dev:web": "npm run dev --workspace web",
    "dev:server": "node scripts/go-runner.js run ./cmd/server",
    "build:web": "npm run build --workspace web",
    "build:server": "node scripts/go-runner.js build ./cmd/server",
    "lint:web": "npm run lint --workspace web",
    "lint:server": "node scripts/go-runner.js test ./..."
  }
}
